# =============================================================================
# Dependencies
# =============================================================================
node_modules/
*/node_modules/
client/node_modules/
server/node_modules/

# =============================================================================
# Environment & Sensitive Credentials (CRITICAL - NEVER COMMIT REAL SECRETS)
# =============================================================================
.env
.env.*
*.env
*.env.*
client/.env
client/.env.*
server/.env
server/.env.*

# Allow example / template environment files
!.env.example
!client/.env.example
!server/.env.example
!**/.env.example

# Credentials & Key files
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
id_rsa
id_rsa.pub

# =============================================================================
# Production Build & Bundler Output
# =============================================================================
dist/
dist-ssr/
build/
client/dist/
client/dist-ssr/
client/build/
.output/

# =============================================================================
# Logs & Runtime Diagnostics
# =============================================================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# =============================================================================
# System & OS Files
# =============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# =============================================================================
# IDE & Code Editor Files
# =============================================================================
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo

